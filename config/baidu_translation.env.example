# Optional legacy adapter: copy to the project root as .env.baidu and edit locally.
# New installations should use the browser API settings page.
# Use fanyi-api.baidu.com (Baidu Translation Open Platform), NOT Baidu AI Cloud keys.
RC_BAIDU_APP_ID=
RC_BAIDU_SECRET_KEY=

# Legacy standard adapter limits: 1000 chars/request, 1 QPS.
# advanced: only after PERSONAL verification + actual service upgrade in console.
RC_BAIDU_PLAN=standard

# Fill these only after checking your account's remaining FREE monthly allowance.
# Start small: current YYYY-MM and 5000, NOT a blanket permission to exceed free quota.
# Blank/stale month or 0 budget prevents any new request. Does not auto-renew.
RC_BAIDU_FREE_TIER_MONTH=
RC_BAIDU_FREE_TIER_CHAR_BUDGET=0
