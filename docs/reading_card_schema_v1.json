                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              },
              "review_status": {
                "const": "unreviewed"
              }
            },
            "additionalProperties": false
          }
        },
        "validation_units": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "unit_id",
              "type",
              "anchor_fact_id",
              "review_status"
            ],
            "properties": {
              "unit_id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "experimental",
                  "theoretical",
                  "simulation",
                  "case_study",
                  "qualitative",
                  "mixed",
                  "other",
                  "uncertain"
                ]
              },
              "anchor_fact_id": {
                "type": "string"
              },
              "review_status": {
                "const": "unreviewed"
              }
            },
            "additionalProperties": false
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "relation_id",
              "from_fact_id",
              "to_fact_id",
              "type",
              "text",
              "kind",
              "evidence_ids",
              "review_status"
            ],
            "properties": {
              "relation_id": {
                "type": "string"
              },
              "from_fact_id": {
                "type": "string"
              },
              "to_fact_id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "motivates",
                  "frames",
                  "addressed_by",
                  "implemented_by",
                  "validated_by",
                  "yields",
                  "supports"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 400
              },
              "kind": {
                "enum": [
                  "author_statement",
                  "analysis"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              },
              "review_status": {
                "const": "unreviewed"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "evidence_references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "evidence_id",
          "paper_id",
          "document_version_id",
          "file_sha256",
          "pdf_page",
          "chunk_id",
          "quote",
          "quote_char_start",
          "quote_char_end",
          "quote_found",
          "locator_valid",
          "semantic_support",
          "review_status"
        ]
      }
    }
  }
}
