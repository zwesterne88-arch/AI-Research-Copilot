# Optional legacy adapter: copy to the project root as .env.google and edit locally.
# New installations should use the browser API settings page.
# Official Google Cloud Translation Basic v2 standard NMT only (model=nmt).
# Enable Cloud Translation API and billing yourself. Restrict the key to that API.
RC_GOOGLE_TRANSLATE_API_KEY=

# Only set these AFTER checking remaining monthly free credits on the billing
# account, including other projects/apps and Basic + Advanced combined usage.
# Example: if >=5000 free characters remain, set the current YYYY-MM and 5000.
# Empty / stale month / zero budget blocks all new requests. Never auto-renews.
RC_GOOGLE_FREE_TIER_MONTH=
RC_GOOGLE_FREE_TIER_CHAR_BUDGET=0

# This app's atomic budget is not Google's real-time balance or a billing cap.
# Also set appropriate Google Cloud quotas; do not rely on budget alerts as caps.
