# Copy to .env locally. Never commit a real key or paste it into chat.
# Optional legacy configuration. New installations can use the API settings page.
# Replace the model ID with one available to your provider account.
RESEARCH_COPILOT_LLM_PROVIDER=deepseek
RESEARCH_COPILOT_LLM_BASE_URL=https://api.deepseek.com
RESEARCH_COPILOT_LLM_MODEL=deepseek-flash
RESEARCH_COPILOT_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
RESEARCH_COPILOT_LLM_TIMEOUT=45
RESEARCH_COPILOT_LLM_MAX_OUTPUT_TOKENS=2000
# Set true only if this provider/model supports response_format=json_object.
RESEARCH_COPILOT_LLM_JSON_MODE=true
# Some models require max_completion_tokens instead of max_tokens.
RESEARCH_COPILOT_LLM_TOKEN_LIMIT_FIELD=max_tokens

# Aliyun TranslateGeneral, 2018-10-12. Backend only; keep real keys local.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_TRANSLATE_ENABLED=
ALIYUN_TRANSLATE_MONTHLY_LIMIT=
# Recommended values after setup: true / 900000. No automatic document calls.
