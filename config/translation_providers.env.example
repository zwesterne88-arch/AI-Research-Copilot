# Optional legacy/local adapters. This template is NOT auto-loaded.
# No engine is installed and no external provider is enabled by this template.
# Local self-hosted LibreTranslate; only loopback HTTP endpoints are accepted.
RC_LIBRETRANSLATE_URL=http://127.0.0.1:5000
RC_LIBRETRANSLATE_MODEL_REVISION=argos-en-zh-operator-verified-version
# Optional, only if YOUR local instance requires authentication:
# RC_LIBRETRANSLATE_API_KEY=

# External public short-segment fallback; disabled until operator enables it.
# Legacy adapter policy is independent of the current account settings workflow.
RC_MYMEMORY_ENABLED=0
# Anonymous route only: <=500 UTF-8 bytes, <=5000 local reserved chars / UTC day.
# Configure current Google and DeepL integrations through the API settings page.
